#!/usr/bin/env bash
# tinkerer: talk to Tinkerer Club for the bar widget.
#
# The QML never holds the member key. This script reads it from a file,
# sends it only as x-api-key, and never prints it.

set -euo pipefail

readonly DEFAULT_BASE_URL="https://app.tinkerer.club"
readonly DEFAULT_KEY_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/secrets/tinkerer-club-api-key"
readonly USER_AGENT="omarchy-plugin-tinkerer-club/0.1.0 (+https://github.com/dneighbors/omarchy-plugin-tinkerer-club)"
readonly MAX_RESPONSE_BYTES=262144

base_url="$DEFAULT_BASE_URL"
key_file="$DEFAULT_KEY_FILE"
feed_limit=20

usage() {
  cat <<'EOF'
Usage: tinkerer [--base-url URL] [--key-file PATH] [--limit N] <command>

Commands:
  status                 Whether a key file exists. Never prints the key.
  feed                   Recent timeline posts as JSON.
  notifications unread   Unread notification count as JSON.
  notifications list     Recent notifications as JSON.
  notifications mark-read ID  Mark one notification read.
  notifications mark-all-read Mark all notifications read.
  lockin state          LockIn room state as JSON.
  lockin start [title]  Start a LockIn session (title max 160).
  lockin finish ID      Finish a LockIn session by id.
  lockin todos          LockIn checklist as JSON.
  lockin todo-add TITLE Add a LockIn checklist item (client UUID).
  lockin todo-done ID   Mark a LockIn todo complete.
  lockin todo-update ID true|false  Set LockIn todo completed flag.
  lockin todo-delete ID Delete a LockIn todo.
  events live           Current or next live broadcast as JSON.
  events upcoming       Upcoming events (next 62 days) as JSON.
  coworking calendar    Your booked and the open coworking sessions (next 15 days) as JSON.
EOF
}

json_error() {
  local error="$1"
  local hint="${2:-}"
  jq -nc --arg error "$error" --arg hint "$hint" \
    '{ok:false, error:$error, hint:$hint}'
}

fail() {
  json_error "$1" "${2:-}"
  exit 0
}

validate_base_url() {
  local value="$1"
  local scheme host

  case "$value" in
    https://*|http://*) ;;
    *) fail "The Tinkerer Club base URL is invalid." "Use an https origin, such as https://app.tinkerer.club." ;;
  esac

  scheme="${value%%://*}"
  host="${value#*://}"
  host="${host%%/*}"
  host="${host%%:*}"

  if [[ "$scheme" == "http" ]]; then
    case "$host" in
      localhost|127.0.0.1|[::1]) ;;
      *) fail "The Tinkerer Club base URL must use HTTPS." "HTTP is allowed only for localhost." ;;
    esac
  elif [[ "$scheme" != "https" ]]; then
    fail "The Tinkerer Club base URL must use HTTPS."
  fi

  printf '%s' "${value%/}"
}

read_api_key() {
  local path="$1"
  local -n _key_out="$2"
  if [[ ! -f "$path" ]]; then
    fail "Add your Tinkerer Club API key." "Write the raw member key to ${path}."
  fi
  if [[ ! -r "$path" ]]; then
    fail "The API key file is not readable." "Check permissions on ${path}."
  fi

  local raw
  raw="$(tr -d '\r' <"$path" | sed -n '1p' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  if [[ -z "$raw" ]]; then
    fail "The API key file is empty." "Put the raw member key on the first line of ${path}."
  fi
  _key_out="$raw"
}

secure_temp() {
  local _var="$1"
  local _path
  _path="$(mktemp "${TMPDIR:-/tmp}/tinkerer.XXXXXX")"
  chmod 600 "$_path"
  printf -v "$_var" '%s' "$_path"
}

api_call() {
  local procedure="$1"
  local body="$2"
  local origin key="" url header_file body_file http_code bytes
  local -a _api_cleanup=()

  _api_call_cleanup() {
    local f
    for f in "${_api_cleanup[@]}"; do
      rm -f "$f"
    done
  }

  origin="$(validate_base_url "$base_url")"
  read_api_key "$key_file" key
  url="${origin}/api/v1/${procedure}"

  secure_temp header_file
  _api_cleanup+=("$header_file")
  secure_temp body_file
  _api_cleanup+=("$body_file")
  trap _api_call_cleanup RETURN

  printf 'x-api-key: %s' "$key" >"$header_file"

  set +e
  http_code="$(
    curl -sS \
      --max-time 15 \
      --max-filesize "$MAX_RESPONSE_BYTES" \
      -X POST \
      -H "Accept: application/json" \
      -H "Content-Type: application/json" \
      -H "User-Agent: ${USER_AGENT}" \
      -H "@${header_file}" \
      --data "$body" \
      -o "$body_file" \
      -w '%{http_code}' \
      "$url"
  )"
  local curl_status=$?
  set -e

  if (( curl_status != 0 )); then
    if [[ -f "$body_file" ]]; then
      bytes="$(wc -c <"$body_file" | tr -d ' ')"
      if (( bytes > MAX_RESPONSE_BYTES )); then
        fail "Tinkerer Club returned an oversized response."
      fi
    fi
    fail "The network request failed." "curl could not reach ${origin}."
  fi

  bytes="$(wc -c <"$body_file" | tr -d ' ')"
  if (( bytes > MAX_RESPONSE_BYTES )); then
    fail "Tinkerer Club returned an oversized response."
  fi

  if [[ "$http_code" == "401" || "$http_code" == "403" ]]; then
    fail "Authentication failed." "Check the member API key file."
  fi
  if [[ "$http_code" != "200" && "$http_code" != "201" ]]; then
    local message
    message="$(
      jq -r '.error.message // .error // .message // empty' "$body_file" 2>/dev/null || true
    )"
    if [[ -z "$message" ]]; then
      message="Tinkerer Club returned HTTP ${http_code}."
    fi
    fail "$message"
  fi

  if ! jq -e . "$body_file" >/dev/null 2>&1; then
    fail "Tinkerer Club returned a non-JSON response."
  fi

  cat "$body_file"
}

unwrap_items() {
  jq -c --arg origin "$(validate_base_url "$base_url")" '
    def unwrap:
      if type == "object" then
        if has("result") then .result | unwrap
        elif has("data") then .data | unwrap
        else . end
      else . end;
    def items:
      (unwrap) as $p
      | if ($p | type) == "array" then $p
        elif ($p | type) == "object" then
          ($p.items // $p.posts // $p.results // [])
        else [] end;
    def text($obj; $keys):
      ($keys | map($obj[.] | select(type == "string" and . != ""))) | .[0] // "";
    def author($item):
      ([$item.author, $item.user, $item.member] | map(select(type == "object")) | .[0] // {}) as $src
      | {
          name: (text($src; ["name","displayName","username"])
            // text($item; ["authorName","username"])
            // "Tinkerer"),
          username: (text($src; ["username","handle"]))
        };
    def resolve($value):
      if ($value | type) != "string" or $value == "" then empty
      else
        if ($value | test("^https?://")) then $value
        else ($origin + "/" + ($value | ltrimstr("/"))) end
      end;
    {
      ok: true,
      posts: [
        items[]
        | select(type == "object")
        | . as $item
        | (text($item; ["id","postId"])) as $id
        | select($id != "")
        | author($item) as $author
        | (text($item; ["type","kind"]) // "POST") as $type
        | {
            id: $id,
            type: $type,
            title: text($item; ["title","headline"]),
            content: (
              text($item; ["content","body","description","summary"])
              // (if $type == "MEMBER_JOINED" then ($author.name + " joined Tinkerer Club.") else "" end)
            ),
            author: $author.name,
            username: $author.username,
            publishedAt: text($item; ["publishedAt","createdAt","updatedAt"]),
            commentCount: ($item.commentCount // $item.commentsCount // $item.replyCount // 0),
            reactionCount: ($item.reactionCount // $item.likeCount // $item.reactionsCount // 0),
            url: (
              [text($item; ["href","url","webUrl","permalink"])]
              | map(resolve(.))
              | .[0] // ($origin + "/posts/" + $id)
            )
          }
      ]
    }
  '
}

unwrap_count() {
  jq -c '
    if type == "object" and .ok == false then .
    else
      def unwrap:
        if type == "object" then
          if has("result") then .result | unwrap
          elif has("data") then .data | unwrap
          else . end
        else . end;
      def as_count:
        if type == "number" then .
        elif type == "string" and test("^[0-9]+$") then tonumber
        elif type == "object" then
          (.count // .unreadCount // .unread // .total // empty) | as_count
        else empty end;
      (unwrap | as_count // null) as $n
      | if $n == null then error("no count")
        else {ok:true, count: (if $n < 0 then 0 else ($n|floor) end)}
        end
    end
  ' 2>/dev/null || fail "Tinkerer Club returned no unread count."
}

unwrap_notifications() {
  jq -c --arg origin "$(validate_base_url "$base_url")" '
    if type == "object" and .ok == false then .
    else
      def unwrap:
        if type == "object" then
          if has("result") then .result | unwrap
          elif has("data") then .data | unwrap
          elif has("json") then .json | unwrap
          else . end
        else . end;
      def text($obj; $keys):
        ($keys | map($obj[.] | select(type == "string" and . != ""))) | .[0] // "";
      def sender($item):
        ([$item.sender, $item.actor, $item.from, $item.user, $item.member, $item.author]
          | map(select(type == "object")) | .[0] // {}) as $src
        | text($src; ["name","displayName","username","handle"]) as $nested
        | text($item; ["senderName","actorName","fromName","authorName"]) as $flat
        | if $nested != "" then $nested
          elif $flat != "" then $flat
          else "Tinkerer" end;
      def resolve($value):
        if ($value | type) != "string" or $value == "" then empty
        else
          if ($value | test("^https?://")) then $value
          elif ($value | test("^[a-zA-Z][a-zA-Z0-9+.-]*:")) then empty
          else ($origin + "/" + ($value | ltrimstr("/"))) end
        end;
      def item_url($item):
        (text($item; ["href","url","webUrl","permalink","targetUrl","link"])) as $direct
        | (if ($item.target | type) == "object" then
             text($item.target; ["href","url","webUrl","permalink","targetUrl","link"])
           else "" end) as $nested
        | ([ $direct, $nested ] | map(select(. != "")) | .[0] // "") as $raw
        | ([$raw] | map(resolve(.)) | .[0] // "");
      def items:
        (unwrap) as $p
        | if ($p | type) == "array" then $p
          elif ($p | type) == "object" then
            ($p.items // $p.notifications // $p.results // [])
          else [] end;
      {
        ok: true,
        notifications: [
          items[]
          | select(type == "object")
          | . as $item
          | (text($item; ["id","notificationId"])) as $id
          | select($id != "")
          | {
              id: $id,
              sender: sender($item),
              title: (text($item; ["title","headline","message","body","content","text","summary"]) | if . == "" then "Notification" else . end),
              createdAt: text($item; ["createdAt","publishedAt","sentAt","timestamp","date","updatedAt"]),
              url: item_url($item)
            }
        ]
      }
    end
  '
}

unwrap_ok() {
  jq -c --arg id "${1:-}" '
    if type == "object" and .ok == false then .
    elif $id != "" then {ok: true, id: $id}
    else {ok: true}
    end
  '
}

unwrap_lockin_state() {
  jq -c '
    if type == "object" and .ok == false then .
    else
      def unwrap:
        if type == "object" then
          if has("result") then .result | unwrap
          elif has("data") then .data | unwrap
          elif has("json") then .json | unwrap
          else . end
        else . end;
      def text($obj; $keys):
        ($keys | map($obj[.] | select(type == "string" and . != ""))) | .[0] // "";
      def participant_name($p):
        (if ($p.user | type) == "object" then
           text($p.user; ["name","displayName","username"])
         else "" end) as $nested
        | if $nested != "" then $nested
          else text($p; ["name","displayName","username"]) // "Tinkerer" end;
      def normalize_session($c):
        if ($c | type) != "object" then null
        else (text($c; ["id"])) as $id
        | if $id == "" then null
          else {
            id: $id,
            title: (text($c; ["title"]) // "LockIn"),
            startedAt: text($c; ["startedAt"]),
            expiresAt: text($c; ["expiresAt"]),
            automaticallyEnded: ($c.automaticallyEnded // false)
          }
          end
        end;
      def normalize_current($c):
        normalize_session($c) as $base
        | if $base == null then null
          elif (text($c; ["endedAt"]) != "") then null
          else $base end;
      def normalize_last($c):
        normalize_session($c) as $base
        | if $base == null then null
        else
          $base + (if text($c; ["endedAt"]) != "" then {endedAt: text($c; ["endedAt"])} else {} end)
          end;
      def participants_list($p):
        if ($p | type) == "array" then $p
        elif ($p | type) == "object" then
          ($p.participants // $p.items // $p.results // [])
        else [] end;
      (unwrap) as $p
      | (normalize_current($p.current // null)) as $current
      | (participants_list($p)) as $raw_parts
      | {
          ok: true,
          current: $current,
          participants: [
            $raw_parts[]
            | select(type == "object")
            | . as $item
            | (text($item; ["id"])) as $id
            | select($id != "")
            | {
                id: $id,
                title: (text($item; ["title"]) // "LockIn"),
                startedAt: text($item; ["startedAt"]),
                expiresAt: text($item; ["expiresAt"]),
                name: participant_name($item)
              }
          ],
          serverNow: (
            if ($p | type) == "object" then
              text($p; ["serverNow","now","timestamp"])
            else "" end
          ),
          onboarded: (
            if ($p | type) == "object" and ($p.onboarded | type) == "boolean" then $p.onboarded
            else false end
          )
        }
      | . + (
          if $current == null then
            (
              if ($p | type) == "object" then
                (
                  if ($p.current | type) == "object" and (text($p.current; ["endedAt"]) != "") then
                    $p.current
                  else
                    ($p.lastEnd // $p.lastSession // $p.endedSession // null)
                  end
                )
              else null end
            ) as $le
            | if $le != null then
                (normalize_last($le)) as $norm
                | if $norm != null then {lastEnd: $norm} else {} end
              else {} end
          else {} end
        )
    end
  '
}

cmd_status() {
  local path="$key_file"
  if [[ -f "$path" && -s "$path" ]]; then
    jq -nc --arg file "$path" '{ok:true, configured:true, apiKeyFile:$file}'
  else
    jq -nc --arg file "$path" \
      '{ok:true, configured:false, apiKeyFile:$file, error:"Add your Tinkerer Club API key.", hint:("Write the raw member key to " + $file + ".")}'
  fi
}

cmd_feed() {
  local payload
  payload="$(api_call "post/timeline" "$(jq -nc --argjson limit "$feed_limit" '{limit:$limit, supportsSparsePages:false}')")"
  printf '%s' "$payload" | unwrap_items
}

cmd_notifications_unread() {
  local payload
  payload="$(api_call "notification/unreadCount" '{}')"
  printf '%s' "$payload" | unwrap_count
}

cmd_notifications_list() {
  local n="$feed_limit"
  local payload
  if (( n < 1 )); then
    n=1
  elif (( n > 50 )); then
    n=50
  fi
  payload="$(api_call "notification/list" "$(jq -nc --argjson limit "$n" '{limit:$limit}')")"
  printf '%s' "$payload" | unwrap_notifications
}

cmd_notifications_mark_read() {
  local id="${1:-}"
  id="${id#"${id%%[![:space:]]*}"}"
  id="${id%"${id##*[![:space:]]}"}"
  if [[ -z "$id" ]]; then
    fail "A notification id is required." "Pass the id as: notifications mark-read ID"
  fi
  local payload
  payload="$(api_call "notification/markRead" "$(jq -nc --arg id "$id" '{id:$id}')")"
  printf '%s' "$payload" | unwrap_ok "$id"
}

cmd_notifications_mark_all_read() {
  local payload
  payload="$(api_call "notification/markAllRead" '{}')"
  printf '%s' "$payload" | unwrap_ok
}

cmd_lockin_state() {
  local payload
  payload="$(api_call "lockIn/state" '{}')"
  printf '%s' "$payload" | unwrap_lockin_state
}

cmd_lockin_start() {
  local title="" payload body
  if (($# > 0)); then
    title="$*"
    title="${title#"${title%%[![:space:]]*}"}"
    title="${title%"${title##*[![:space:]]}"}"
    if ((${#title} > 160)); then
      title="${title:0:160}"
    fi
  fi
  if [[ -n "$title" ]]; then
    body="$(jq -nc --arg title "$title" '{title:$title}')"
  else
    body='{}'
  fi
  payload="$(api_call "lockIn/start" "$body")"
  printf '%s' "$payload" | unwrap_ok
}

cmd_lockin_finish() {
  local id="${1:-}"
  id="${id#"${id%%[![:space:]]*}"}"
  id="${id%"${id##*[![:space:]]}"}"
  if [[ -z "$id" ]]; then
    fail "A LockIn session id is required." "Pass the id as: lockin finish ID"
  fi
  local payload
  payload="$(api_call "lockIn/finish" "$(jq -nc --arg id "$id" '{id:$id}')")"
  printf '%s' "$payload" | unwrap_ok
}

unwrap_lockin_todos() {
  jq -c '
    if type == "object" and .ok == false then .
    else
      def unwrap:
        if type == "object" then
          if has("result") then .result | unwrap
          elif has("data") then .data | unwrap
          elif has("json") then .json | unwrap
          else . end
        else . end;
      def text($obj; $keys):
        ($keys | map($obj[.] | select(type == "string" and . != ""))) | .[0] // "";
      def todos_list($p):
        if ($p | type) == "array" then $p
        elif ($p | type) == "object" then
          ($p.todos // $p.items // $p.results // [])
        else [] end;
      def normalize_todo($t):
        if ($t | type) != "object" then empty
        else (text($t; ["id"])) as $id
        | select($id != "")
        | {
            id: $id,
            title: text($t; ["title"]),
            completed: ($t.completed // false),
            deleted: ($t.deleted // false),
            createdAt: text($t; ["createdAt"])
          }
        end;
      (unwrap) as $p
      | {
          ok: true,
          todos: [
            todos_list($p)[]
            | normalize_todo(.)
            | select(. != null and .deleted != true)
          ]
        }
    end
  '
}

new_todo_uuid() {
  if [[ -n "${TINKERER_TODO_UUID:-}" ]]; then
    printf '%s' "$TINKERER_TODO_UUID"
    return 0
  fi
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen
    return 0
  fi
  if [[ -r /proc/sys/kernel/random/uuid ]]; then
    tr -d '\n' </proc/sys/kernel/random/uuid
    return 0
  fi
  fail "Could not generate a todo id." "Install uuidgen or use a Linux kernel with /proc/sys/kernel/random/uuid."
}

cmd_lockin_todos() {
  local payload
  payload="$(api_call "lockIn/todos" '{}')"
  printf '%s' "$payload" | unwrap_lockin_todos
}

cmd_lockin_todo_add() {
  local title="" payload id
  if (($# > 0)); then
    title="$*"
    title="${title#"${title%%[![:space:]]*}"}"
    title="${title%"${title##*[![:space:]]}"}"
  fi
  if [[ -z "$title" ]]; then
    fail "A todo title is required." "Pass the title as: lockin todo-add TITLE"
  fi
  if ((${#title} > 200)); then
    title="${title:0:200}"
  fi
  id="$(new_todo_uuid)"
  id="${id#"${id%%[![:space:]]*}"}"
  id="${id%"${id##*[![:space:]]}"}"
  payload="$(api_call "lockIn/createTodo" "$(jq -nc --arg id "$id" --arg title "$title" '{id:$id, title:$title}')")"
  printf '%s' "$payload" | unwrap_ok "$id"
}

cmd_lockin_todo_update() {
  local id="${1:-}" completed="${2:-}"
  id="${id#"${id%%[![:space:]]*}"}"
  id="${id%"${id##*[![:space:]]}"}"
  completed="${completed#"${completed%%[![:space:]]*}"}"
  completed="${completed%"${completed##*[![:space:]]}"}"
  if [[ -z "$id" ]]; then
    fail "A todo id is required." "Pass the id as: lockin todo-update ID true|false"
  fi
  case "$completed" in
    true|false) ;;
    *)
      fail "A completed flag is required." "Use true or false: lockin todo-update ID true|false"
      ;;
  esac
  local payload
  payload="$(api_call "lockIn/updateTodo" "$(jq -nc --arg id "$id" --arg completed "$completed" '{id:$id, completed: ($completed == "true")}')")"
  printf '%s' "$payload" | unwrap_ok
}

cmd_lockin_todo_done() {
  cmd_lockin_todo_update "${1:-}" "true"
}

cmd_lockin_todo_delete() {
  local id="${1:-}"
  id="${id#"${id%%[![:space:]]*}"}"
  id="${id%"${id##*[![:space:]]}"}"
  if [[ -z "$id" ]]; then
    fail "A todo id is required." "Pass the id as: lockin todo-delete ID"
  fi
  local payload
  payload="$(api_call "lockIn/deleteTodo" "$(jq -nc --arg id "$id" '{id:$id}')")"
  printf '%s' "$payload" | unwrap_ok
}

unwrap_live_banner() {
  jq -c --arg origin "$(validate_base_url "$base_url")" --arg now "${TINKERER_NOW:-}" '
    if type == "object" and .ok == false then .
    else
      def unwrap:
        if type == "object" then
          if has("result") then .result | unwrap
          elif has("data") then .data | unwrap
          elif has("json") then .json | unwrap
          else . end
        else . end;
      def text($obj; $keys):
        ($keys | map($obj[.] | select(type == "string" and . != ""))) | .[0] // "";
      def stamp($value):
        if ($value | type) != "string" or $value == "" then null
        else ($value | sub("\\.[0-9]+"; "") | sub("(?<z>[+-][0-9]{2}):?[0-9]{2}$"; "Z") | try fromdateiso8601 catch null)
        end;
      def resolve($value):
        if ($value | type) != "string" or $value == "" then empty
        elif ($value | test("^https?://")) then $value
        elif ($value | test("^[a-zA-Z][a-zA-Z0-9+.-]*:")) then empty
        else ($origin + "/" + ($value | ltrimstr("/"))) end;
      def pick($p):
        if ($p | type) == "array" then ($p | map(select(type == "object")) | .[0] // null)
        elif ($p | type) == "object" then
          (if ($p.event | type) == "object" then $p.event
           elif ($p.live | type) == "object" then $p.live
           elif ($p.broadcast | type) == "object" then $p.broadcast
           else $p end)
        else null end;
      (if $now != "" then ($now | tonumber) else now end) as $t
      | (pick(unwrap)) as $e
      | if $e == null then {ok: true, live: null}
        else
          (text($e; ["id","eventId","liveEventId"])) as $id
          | (text($e; ["broadcastStatus","status","state"]) | ascii_upcase) as $status
          | (text($e; ["startsAt","startAt","startTime","scheduledAt"])) as $starts
          | (text($e; ["endsAt","endAt","endTime","endedAt"])) as $ends
          | (stamp($starts)) as $s
          | (stamp($ends)) as $f
          | if $id == "" then {ok: true, live: null}
            elif ($status == "ENDED" or $status == "CANCELED" or $status == "CANCELLED") then {ok: true, live: null}
            elif ($f != null and $f <= $t and $status != "LIVE") then {ok: true, live: null}
            else
              {
                ok: true,
                live: {
                  id: $id,
                  title: (text($e; ["title","name"]) | if . == "" then "Live session" else . end),
                  status: (if $status == "" then
                             (if $s != null and $s <= $t then "LIVE" else "SCHEDULED" end)
                           else $status end),
                  isLive: (if $status == "LIVE" then true
                           elif $status == "" then ($s != null and $s <= $t)
                           else false end),
                  startsAt: $starts,
                  endsAt: $ends,
                  url: (
                    [text($e; ["href","url","webUrl","permalink","link"])]
                    | map(resolve(.))
                    | .[0] // ($origin + "/live/" + ($id | @uri))
                  )
                }
              }
            end
        end
    end
  '
}

cmd_events_live() {
  local payload
  payload="$(api_call "event/liveBanner" '{}')"
  printf '%s' "$payload" | unwrap_live_banner
}

unwrap_calendar() {
  jq -c --arg origin "$(validate_base_url "$base_url")" --arg now "${TINKERER_NOW:-}" --argjson limit "$1" '
    if type == "object" and .ok == false then .
    else
      def unwrap:
        if type == "object" then
          if has("result") then .result | unwrap
          elif has("data") then .data | unwrap
          elif has("json") then .json | unwrap
          else . end
        else . end;
      def text($obj; $keys):
        ($keys | map($obj[.] | select(type == "string" and . != ""))) | .[0] // "";
      def stamp($value):
        if ($value | type) != "string" or $value == "" then null
        else ($value | sub("\\.[0-9]+"; "") | sub("(?<z>[+-][0-9]{2}):?[0-9]{2}$"; "Z") | try fromdateiso8601 catch null)
        end;
      def resolve($value):
        if ($value | type) != "string" or $value == "" then empty
        elif ($value | test("^https?://")) then $value
        elif ($value | test("^[a-zA-Z][a-zA-Z0-9+.-]*:")) then empty
        else ($origin + "/" + ($value | ltrimstr("/"))) end;
      def items:
        (unwrap) as $p
        | if ($p | type) == "array" then $p
          elif ($p | type) == "object" then ($p.events // $p.items // $p.results // [])
          else [] end;
      (if $now != "" then ($now | tonumber) else now end) as $t
      | {
          ok: true,
          events: (
            [
              items[]
              | select(type == "object")
              | . as $e
              | (text($e; ["id","eventId"])) as $id
              | select($id != "")
              | (text($e; ["broadcastStatus"]) | ascii_upcase) as $broadcast
              | (text($e; ["status","state"]) | ascii_upcase) as $status
              | select(([$broadcast, $status] | map(select(. == "ENDED" or . == "CANCELED" or . == "CANCELLED")) | length) == 0)
              | (text($e; ["startsAt","startAt","startTime","scheduledAt"])) as $base_starts
              | (text($e; ["endsAt","endAt","endTime"])) as $base_ends
              | (text($e; ["occurrenceStart"])) as $occurrence
              | (stamp($base_starts)) as $bs
              | (stamp($base_ends)) as $bf
              | (if $occurrence != "" and stamp($occurrence) != null then $occurrence else $base_starts end) as $starts
              | (stamp($starts)) as $s
              # A recurring occurrence keeps the series end time; shift it by the same offset.
              | (if $bf != null and $bs != null and $s != null then $s + ($bf - $bs) else $bf end) as $f
              | (if $starts == $base_starts or $f == null then $base_ends else ($f | todateiso8601) end) as $ends
              | select($s != null)
              | select(if $f != null then $f > $t else $s >= $t end)
              | {
                  id: $id,
                  title: (text($e; ["title","name"]) | if . == "" then "Event" else . end),
                  type: text($e; ["type"]),
                  startsAt: $starts,
                  endsAt: $ends,
                  isLive: ($broadcast == "LIVE" or ($s <= $t)),
                  url: (
                    [text($e; ["href","url","webUrl","permalink","link"])]
                    | map(resolve(.))
                    | .[0] // ($origin + "/events/" + ($id | @uri))
                  ),
                  _s: $s
                }
            ]
            | unique_by(.id + "|" + .startsAt)
            | sort_by(._s)
            | map(del(._s))
            | .[0:$limit]
          )
        }
    end
  '
}

cmd_events_upcoming() {
  local n="$feed_limit" window payload
  if (( n < 1 )); then
    n=1
  elif (( n > 50 )); then
    n=50
  fi
  # event.calendar rejects windows longer than 62 days.
  window="$(jq -nc --arg now "${TINKERER_NOW:-}" '
    (if $now != "" then ($now | tonumber) else now end | floor) as $t
    | {from: ($t | todateiso8601), to: (($t + 62 * 86400) | todateiso8601)}
  ')"
  payload="$(api_call "event/calendar" "$window")"
  printf '%s' "$payload" | unwrap_calendar "$n"
}

unwrap_coworking() {
  jq -c --arg origin "$(validate_base_url "$base_url")" --arg now "${TINKERER_NOW:-}" --argjson limit "$1" '
    if type == "object" and .ok == false then .
    else
      def unwrap:
        if type == "object" then
          if has("result") then .result | unwrap
          elif has("data") then .data | unwrap
          elif has("json") then .json | unwrap
          else . end
        else . end;
      def text($obj; $keys):
        if ($obj | type) != "object" then ""
        else ($keys | map($obj[.] | select(type == "string" and . != ""))) | .[0] // "" end;
      def stamp($value):
        if ($value | type) != "string" or $value == "" then null
        else ($value | sub("\\.[0-9]+"; "") | sub("(?<z>[+-][0-9]{2}):?[0-9]{2}$"; "Z") | try fromdateiso8601 catch null)
        end;
      # Only links on the configured origin survive; anything else falls back
      # to the coworking page.
      def resolve($value):
        if ($value | type) != "string" or $value == "" then empty
        elif ($value | test("^https?://"; "i")) then
          (if $value == $origin or ($value | startswith($origin + "/")) then $value else empty end)
        elif ($value | test("^[a-zA-Z][a-zA-Z0-9+.-]*:")) then empty
        elif ($value | test("[\\\\\\s]")) then empty
        else ($origin + "/" + ($value | sub("^/+"; ""))) end;
      def person($p):
        if ($p | type) == "string" then $p
        elif ($p | type) == "object" then
          ([$p.user, $p.member, $p.profile] | map(select(type == "object")) | .[0] // {}) as $src
          | text($src; ["name","displayName","username","handle"]) as $nested
          | if $nested != "" then $nested
            else text($p; ["name","displayName","username","handle"]) end
        else "" end;
      def people($v):
        if ($v | type) == "array" then [$v[] | person(.) | select(. != "")]
        elif ($v | type) == "object" then
          (if ([$v.participants, $v.members, $v.users, $v.matches] | map(select(type == "array")) | length) > 0
           then [[$v.participants, $v.members, $v.users, $v.matches][] | select(type == "array") | people(.)[]]
           else [person($v) | select(. != "")] end)
        else [] end;
      def list($p; $keys):
        if ($p | type) != "object" then []
        else ($keys | map($p[.] | select(type == "array")) | .[0] // []) end;
      def sessions($raw; $matched; $t):
        [
          $raw[]
          | select(type == "object")
          | . as $e
          | (if ($e.slot | type) == "object" then $e.slot else {} end) as $slot
          | (text($e; ["id","sessionId","slotId"])) as $id
          | select($id != "")
          | (text($e; ["status","state"]) | ascii_upcase) as $status
          | select($status != "ENDED" and $status != "CANCELED" and $status != "CANCELLED" and $status != "COMPLETED")
          | ["startsAt","startAt","startTime","scheduledAt","slotStart","start"] as $sk
          | ["endsAt","endAt","endTime","slotEnd","end"] as $ek
          | (text($e; $sk) | if . == "" then text($slot; $sk) else . end) as $starts
          | (text($e; $ek) | if . == "" then text($slot; $ek) else . end) as $base_ends
          | (stamp($starts)) as $s
          | select($s != null)
          | ([$e.durationMinutes, $e.duration, $slot.durationMinutes] | map(select(type == "number" and . > 0)) | .[0] // null) as $minutes
          | (stamp($base_ends) // (if $minutes != null then $s + $minutes * 60 else null end)) as $f
          | (if $base_ends != "" then $base_ends elif $f != null then ($f | todateiso8601) else "" end) as $ends
          | select(if $f != null then $f > $t else $s >= $t end)
          | ([$e.host, $e.owner, $e.creator, $e.createdBy, $e.organizer] | map(person(.) | select(. != "")) | .[0]
             // text($e; ["hostName","ownerName","creatorName"])) as $host
          | ([
               people($e.participants), people($e.members), people($e.attendees),
               people($e.matches), people($e.partner), people($e.partners), people($e.match),
               (if ($matched | type) == "object" then
                  ([$id, $starts, text($e; ["slotId"]), text($slot; ["id"])]
                   | map(select(. != "") | $matched[.] | select(. != null)) | .[0] // null | people(.))
                else [] end)
             ] | add | map(select(. != $host))
             | reduce .[] as $n ([]; if index($n) then . else . + [$n] end)
             | .[0:8]) as $people
          | {
              id: $id,
              title: (text($e; ["title","name","topic","label"])
                | if . == "" then text($slot; ["title","name","label"]) else . end
                | if . == "" then "Coworking session" else . end),
              host: $host,
              people: $people,
              startsAt: $starts,
              endsAt: $ends,
              isLive: ($s <= $t),
              url: (
                [text($e; ["href","url","webUrl","permalink","link"])]
                | map(resolve(.))
                | .[0] // ($origin + "/coworking")
              ),
              _s: $s
            }
        ]
        | unique_by(.id + "|" + .startsAt)
        | sort_by(._s)
        | map(del(._s))
        | .[0:$limit];
      (unwrap) as $p
      # The server clock wins, so a wrong local clock does not hide sessions.
      | (stamp(text($p; ["serverNow","now"]))
         // (if $now != "" then ($now | tonumber) else now end)) as $t
      | (if ($p | type) == "object" then $p.matchedBySlot else null end) as $matched
      | (if ($p | type) == "array" then $p else list($p; ["openSessions","open","sessions","items","results"]) end) as $open
      | (sessions(list($p; ["mySessions","mine","booked"]); $matched; $t)) as $mine
      | {
          ok: true,
          mine: $mine,
          # A session you booked is listed once, under yours.
          open: [sessions($open; $matched; $t)[] | select(. as $o | ($mine | map(.id + "|" + .startsAt) | index($o.id + "|" + $o.startsAt)) == null)]
        }
    end
  '
}

cmd_coworking_calendar() {
  local n="$feed_limit" window payload
  if (( n < 1 )); then
    n=1
  elif (( n > 50 )); then
    n=50
  fi
  # The site asks coworking.calendar for the next 15 days.
  window="$(jq -nc --arg now "${TINKERER_NOW:-}" '
    (if $now != "" then ($now | tonumber) else now end | floor) as $t
    | {from: ($t | todateiso8601), to: (($t + 15 * 86400) | todateiso8601)}
  ')"
  payload="$(api_call "coworking/calendar" "$window")"
  printf '%s' "$payload" | unwrap_coworking "$n"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base-url)
      base_url="${2:-}"
      shift 2
      ;;
    --key-file)
      key_file="${2:-}"
      shift 2
      ;;
    --limit)
      feed_limit="${2:-20}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      fail "Unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

command="${1:-}"
case "$command" in
  status) cmd_status ;;
  feed) cmd_feed ;;
  notifications)
    case "${2:-}" in
      unread) cmd_notifications_unread ;;
      list) cmd_notifications_list ;;
      mark-read) cmd_notifications_mark_read "${3:-}" ;;
      mark-all-read) cmd_notifications_mark_all_read ;;
      "") fail "Unknown command: notifications" ;;
      *) fail "Unknown command: $2" ;;
    esac
    ;;
  lockin)
    case "${2:-}" in
      state) cmd_lockin_state ;;
      start)
        shift 2
        cmd_lockin_start "$@"
        ;;
      finish)
        cmd_lockin_finish "${3:-}"
        ;;
      todos) cmd_lockin_todos ;;
      todo-add)
        shift 2
        cmd_lockin_todo_add "$@"
        ;;
      todo-done)
        cmd_lockin_todo_done "${3:-}"
        ;;
      todo-update)
        cmd_lockin_todo_update "${3:-}" "${4:-}"
        ;;
      todo-delete)
        cmd_lockin_todo_delete "${3:-}"
        ;;
      "") fail "Unknown command: lockin" ;;
      *) fail "Unknown command: $2" ;;
    esac
    ;;
  events)
    case "${2:-}" in
      live) cmd_events_live ;;
      upcoming) cmd_events_upcoming ;;
      "") fail "Unknown command: events" ;;
      *) fail "Unknown command: $2" ;;
    esac
    ;;
  coworking)
    case "${2:-}" in
      calendar) cmd_coworking_calendar ;;
      "") fail "Unknown command: coworking" ;;
      *) fail "Unknown command: $2" ;;
    esac
    ;;
  "") usage; exit 2 ;;
  *) fail "Unknown command: $command" ;;
esac
